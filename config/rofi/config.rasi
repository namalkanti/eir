configuration {
    modi: "drun,run,window";
    font: "MesloLGS Nerd Font 10";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "wezterm";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    accent: #89b4fa;

    background-color: @bg;
    text-color: @fg;
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 30%;
    border: 2;
    border-color: @accent;
    border-radius: 8px;
    background-color: @bg;
    padding: 10;
}

element {
    padding: 6 8;
    border-radius: 4px;
    text-color: @fg;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
}

entry {
    padding: 8;
    text-color: @fg;
}

inputbar {
    children: [entry];
}
